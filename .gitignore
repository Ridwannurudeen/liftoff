# Compiler files
cache/
out/

# Ignores development (and goerli) broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/*/5/
/broadcast/**/dry-run/

# Docs — ignore generated `forge doc` output, but keep authored design docs
docs/*
!docs/DESIGN-phase3-5.md
!docs/ERC-launch-covenants.md

# Dotenv file
.env

# Node modules
node_modules/

# Demo-only second-bidder key (v2 commit-reveal mainnet demo)
.bidder2-key

# SDK build artifacts
sdk/dist/
sdk/node_modules/

# Next.js launch dApp build artifacts
app/node_modules/
app/.next/
app/.next-types/
app/next-env.d.ts
app/tsconfig.tsbuildinfo
